<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Rook Archive Sync — launchd agent

  Replaces the cron entry. launchd agents inherit the user's
  Full Disk Access grant, so rsync/cp into Dropbox CloudStorage
  succeeds without "Operation not permitted".

  Install:
    cp com.rook.sync.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.rook.sync.plist

  Remove old cron:
    crontab -e  →  delete the */15 rook_sync line

  Check status:
    launchctl list | grep rook

  ProgramArguments MUST point at ~/bin/rook_sync.sh, not at the repo copy:
  launchd cannot execute a script out of ~/Library/CloudStorage/Dropbox
  ("Operation not permitted" — verified 2026-08-18), even though the same job
  can write into Dropbox.

  Install BOTH this plist and that local copy with install_mac_sync.sh — never
  hand-copy either one. The copy is taken at install time and is NOT refreshed
  per run, so after editing sync_archive.sh you must re-run the installer or the
  schedule keeps executing the old code. A hand-copied fork living there froze at
  May 2026 and silently starved the pipeline of classified/ frames until
  2026-08-18, when 1,151 stranded frames were recovered. sync_archive.sh prints
  its own installed mtime and writes archive/.sync_status.json so this drift is
  visible instead of silent.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rook.sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/matthewcook/bin/rook_sync.sh</string>
    </array>

    <!-- Every 15 minutes (900 seconds) -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>StandardOutPath</key>
    <string>/tmp/rook_sync.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/rook_sync.log</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
